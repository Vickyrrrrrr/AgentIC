# =============================================================================
# AgentIC — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All fields except LLM_API_KEY + LLM_MODEL are optional.

# ── Universal LLM (required — pick any OpenAI-compatible provider) ───────────
#
#   OpenAI:      LLM_MODEL=gpt-4o                LLM_BASE_URL=https://api.openai.com/v1
#   Anthropic:   LLM_MODEL=anthropic/claude-3-5-sonnet   (no base_url needed)
#   Groq:        LLM_MODEL=llama-3.3-70b-versatile       LLM_BASE_URL=https://api.groq.com/openai/v1
#   NVIDIA NIM:  LLM_MODEL=meta/llama-3.3-70b-instruct   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   Ollama:      LLM_MODEL=ollama/qwen2.5-coder:7b       LLM_BASE_URL=http://localhost:11434  LLM_API_KEY=NA
#   Together AI: LLM_MODEL=meta-llama/Llama-3-70b        LLM_BASE_URL=https://api.together.xyz/v1
#   OpenRouter:  LLM_MODEL=openai/gpt-4o                 LLM_BASE_URL=https://openrouter.ai/api/v1

LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ── Optional: Per-role overrides ──────────────────────────────────────────────
# Use different models per agent role for cost optimization.
# Each role falls back to LLM_MODEL / LLM_BASE_URL / LLM_API_KEY if not set.
#
# ROLE_DESIGNER_MODEL=gpt-4o
# ROLE_DESIGNER_BASE_URL=https://api.openai.com/v1
# ROLE_DESIGNER_API_KEY=
#
# ROLE_FIXER_MODEL=anthropic/claude-3-5-sonnet
# ROLE_FIXER_BASE_URL=
# ROLE_FIXER_API_KEY=
#
# ROLE_DOCUMENTER_MODEL=llama-3.3-70b-versatile
# ROLE_DOCUMENTER_BASE_URL=https://api.groq.com/openai/v1
# ROLE_DOCUMENTER_API_KEY=your_groq_key
#
# Available roles: architect, designer, testbench_designer, verifier,
#                  fixer, debugger, manager, physical, documenter, reporter

# ── Container Infrastructure ──────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password
REDIS_PASSWORD=change_me_strong_password
MINIO_ROOT_USER=agentic_minio_admin
MINIO_ROOT_PASSWORD=change_me_strong_password

# ── Frontend URL (CORS whitelist) ─────────────────────────────────────────────
FRONTEND_URL=https://your-vercel-app.vercel.app

# ── Public deployment safety ──────────────────────────────────────────────────
# Keep false in production — users must bring their own LLM key.
# Set to true only for private/local testing.
ALLOW_BACKEND_LLM_FALLBACK=false

# ── Supabase Auth (leave blank to disable auth — all builds allowed) ─────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
# REQUIRED if using BYOK plan — generate: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# ── Razorpay Billing (leave blank to disable payments) ───────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── PDK Profile ───────────────────────────────────────────────────────────────
PDK_PROFILE=sky130
# PDK_PROFILE=gf180

# ── EDA Tool binary overrides (auto-detected from OSS CAD Suite) ─────────────
# Only set these if auto-detection fails or you want to pin specific paths.
# YOSYS_BIN=/opt/oss-cad-suite/bin/yosys
# SBY_BIN=/opt/oss-cad-suite/bin/sby
# EQY_BIN=/opt/oss-cad-suite/bin/eqy
# VERILATOR_BIN=/opt/oss-cad-suite/bin/verilator
# IVERILOG_BIN=/opt/oss-cad-suite/bin/iverilog
# VVP_BIN=/opt/oss-cad-suite/bin/vvp

# ── Oracle / Self-hosted ──────────────────────────────────────────────────────
# OSS_CAD_SUITE_HOME=/opt/oss-cad-suite
# Override if official ARM64 OpenLane image is unavailable on Oracle A1:
# OPENLANE_IMAGE=ghcr.io/the-openroad-project/openlane:ff5509f65b17bfa4068d5336495ab1718987ff69-amd64

# ── Verilog Code-Gen override (optional) ──────────────────────────────────────
VERILOG_CODEGEN_ENABLED=false
VERILOG_CODEGEN_MODEL=
VERILOG_CODEGEN_BASE_URL=
VERILOG_CODEGEN_API_KEY=
