# =============================================================================
# AgentIC — Minimal Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# AgentIC will auto-detect the provider and configure all sub-agents.

# ── LLM Configuration ─────────────────────────────────────────────────
# Set this single key to power all AgentIC LLM calls.
# By default, it expects an OpenAI key, but any OpenAI-compatible provider works.
OPENAI_API_KEY=your-api-key-here

# Optional: If you are using a custom provider (e.g., Zhipu, DeepSeek, Anthropic, vLLM)
# uncomment and set these:
# LLM_BASE_URL=https://api.z.ai/api/paas/v4/
# LLM_MODEL=glm-5.1
# LLM_API_KEY=your-api-key-here (if not using OPENAI_API_KEY)

# Hosted AgentIC Infinite model (Azure OpenAI via LiteLLM)
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-08-01-preview
# VERILOG_CODEGEN_ENABLED=1
# VERILOG_CODEGEN_MODEL=azure/your-deployment-name
# VERILOG_CODEGEN_API_KEY=your-azure-openai-key
# VERILOG_CODEGEN_BASE_URL=${AZURE_API_BASE}
# LLM_MODEL=${VERILOG_CODEGEN_MODEL}
# LLM_API_KEY=${VERILOG_CODEGEN_API_KEY}
# LLM_BASE_URL=${AZURE_API_BASE}
