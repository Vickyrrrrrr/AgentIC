# =============================================================================
# AgentIC — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables are actually used by the codebase unless marked optional.

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED VALUES
# ═══════════════════════════════════════════════════════════════════════════

# ── LLM Configuration ─────────────────────────────────────────────────
# Get your API key from any OpenAI-compatible provider:
#   - OpenAI: https://platform.openai.com
#   - Anthropic: https://console.anthropic.com
#   - Groq: https://console.groq.com
#   - Ollama: http://localhost:11434 (local)
#   - NVIDIA NIM, Together AI, etc.
LLM_API_KEY=sk-YOUR_KEY_HERE
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ── Container Infrastructure ─────────────────────────────────────────────
# These are REQUIRED for Docker containers to work
POSTGRES_PASSWORD=your_secure_password
REDIS_PASSWORD=your_secure_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_password

# ── Oracle Deploy (Required) ─────────────────────────────────────────────
# Must be true for workflow validation - allows no LLM key for builds
ALLOW_BACKEND_LLM_FALLBACK=true

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL VALUES (Can leave blank or remove if not needed)
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase Auth (Optional - leave blank to disable auth) ─────────────
# Get from: Supabase Dashboard → Project Settings → API
# SUPABASE_URL=https://xyz.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key
# SUPABASE_JWT_SECRET=your_jwt_secret
# REQUIRED if using BYOK plan - generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ENCRYPTION_KEY=your_32_char_hex_key

# ── Razorpay Billing (Optional - leave blank to disable payments) ─────────────
# Get from: Razorpay Dashboard → Settings → API Keys
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ── PDK Configuration (Optional - defaults to sky130) ─────────────────────
# PDK_PROFILE=sky130
# PDK_ROOT=~/.ciel/pdk

# ── Rate Limiting (Optional - for heavy usage) ───────────────────────────
# AGENTIC_GLOBAL_LLM_RPM=120
# AGENTIC_GLOBAL_LLM_CONCURRENCY=4
# AGENTIC_TOKEN_WARNING_RATIO=0.85

# ═══════════════════════════════════════════════════════════════════════════
# ADVANCED / RARELY NEEDED
# ═══════════════════════════════════════════════════════════════════════════

# OSS CAD Suite (auto-detected - rarely need to override)
# OSS_CAD_SUITE_HOME=/opt/oss-cad-suite

# OpenLane (auto-detected - rarely need to override)
# OPENLANE_ROOT=/path/to/openlane

# EDA Tool Binary Overrides (auto-detected - rarely need to override)
# YOSYS_BIN=/opt/oss-cad-suite/bin/yosys
# VERILATOR_BIN=/opt/oss-cad-suite/bin/verilator
# IVERILOG_BIN=/opt/oss-cad-suite/bin/iverilog
# VVP_BIN=/opt/oss-cad-suite/bin/vvp
# SBY_BIN=/opt/oss-cad-suite/bin/sby

# Oracle ARM64 image override (only if needed)
# OPENLANE_IMAGE=ghcr.io/the-openroad-project/openlane:2024.12.31-arm64

# ── Lemon Squeezy License ──────────────────────────────────────────────
# The License API is public — no API key required for validation.
# Users activate their license key during `agentic login` and it's validated
# against api.lemonsqueezy.com/v1/licenses/validate on every build.
# Manage licenses at: https://app.lemonsqueezy.com
# Purchase page: https://agentic.lemonsqueezy.com (set via AGENTIC_LICENSE_PURCHASE_URL)

# ── Seller Master Key (YOUR SECRET — never share) ──────────────────────
# Set this to bypass license checks on YOUR machine only.
# For extra security, pre-compute the SHA-256 hash:
#   echo -n "your-secret-hereagentic-internal-3c7a9b1f" | sha256sum
# And set _AGENTIC_MASTER_HASH=<that_hash> instead of the raw key.
AGENTIC_MASTER_KEY=your-secret-seller-key-here
# _AGENTIC_MASTER_HASH=abc123...precomputed...hash