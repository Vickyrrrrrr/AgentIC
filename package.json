{
  "name": "agentic-vlsi",
  "version": "1.0.0",
  "description": "AgentIC — Autonomous AI chip design agents as importable TypeScript modules",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./llm": {
      "import": "./dist/llm/index.js",
      "types": "./dist/llm/index.d.ts"
    },
    "./eda": {
      "import": "./dist/eda/index.js",
      "types": "./dist/eda/index.d.ts"
    },
    "./stages": {
      "import": "./dist/stages/index.js",
      "types": "./dist/stages/index.d.ts"
    },
    "./agents": {
      "import": "./dist/agents/index.js",
      "types": "./dist/agents/index.d.ts"
    },
    "./orchestrator": {
      "import": "./dist/orchestrator/index.js",
      "types": "./dist/orchestrator/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "tsc",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:lib": "tsc --noEmit"
  },
  "keywords": [
    "chip-design",
    "vlsi",
    "eda",
    "ai",
    "llm",
    "verilog",
    "silicon",
    "rtl",
    "synthesis",
    "tscircuit"
  ],
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "@xyflow/react": "^12.11.6",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.47.0",
    "openai": "^4.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
