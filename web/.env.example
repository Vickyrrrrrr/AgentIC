# AgentIC Web Frontend Environment Variables

# Production: HuggingFace Space URL
# VITE_API_BASE_URL=https://vxkyyy-agentIC.hf.space

# Local development: Docker container
# VITE_API_BASE_URL=http://localhost:7860

# If left blank, the Vite proxy handles it automatically during local dev
# and falls back to http://localhost:7860
VITE_API_BASE_URL=

# Set this to true when deploying into the cloud (HuggingFace, Render, etc.)
# It will disable local-only features like the Desktop GTKWave pop-up launcher
VITE_IS_CLOUD=false

# Waitlist System
# Set to 'true' to show the Landing Page + Waitlist Dashboard for new users
VITE_WAITLIST_MODE=true

# Comma-separated list of emails that can skip the waitlist and access the full app
VITE_WHITELISTED_EMAILS=admin@agentic.ai,vicky@agentic.ai
